@model List<RaceDayMVC.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "Race Results - RaceDay";
    var userRole = ViewBag.UserRole ?? "";
    var isOrganiser = userRole?.Equals("Organiser", StringComparison.OrdinalIgnoreCase) ?? false;
    var pageTitle = isOrganiser ? "Event Results" : "My Race Results";
}

<div class="results-page">
    <!-- Page Header -->
    <div class="page-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px 0; margin-bottom: 40px;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12">
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="fas fa-trophy me-3"></i>@pageTitle
                    </h1>
                    <p class="lead mb-0 text-white-50">
                        @(isOrganiser 
                            ? "View and analyze race results for all participants."
                            : "Track your race performance and personal records.")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="container mb-5">
        <div class="row">
            <div class="col-12">
                @if (Model != null && Model.Any())
                {
                    <!-- Results Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-muted mb-2">Total Races</h5>
                                    <h2 class="text-primary fw-bold">@Model.Count</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-muted mb-2">Best Finish Time</h5>
                                    <h2 class="text-success fw-bold">
                                        @{
                                            var bestTime = Model
                                                .Where(r => r.FinishTime.HasValue)
                                                .OrderBy(r => r.FinishTime)
                                                .FirstOrDefault()?.FinishTime;

                                            if (bestTime.HasValue)
                                            {
                                                @bestTime.Value.ToString(@"hh\:mm\:ss")
                                            }
                                            else
                                            {
                                                <text>—</text>
                                            }
                                        }
                                    </h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-muted mb-2">Best Overall Position</h5>
                                    <h2 class="text-warning fw-bold">
                                        @{
                                            var bestPosition = Model
                                                .Where(r => r.OverallPosition.HasValue)
                                                .OrderBy(r => r.OverallPosition)
                                                .FirstOrDefault()?.OverallPosition;

                                            if (bestPosition.HasValue)
                                            {
                                                <text>#@bestPosition</text>
                                            }
                                            else
                                            {
                                                <text>—</text>
                                            }
                                        }
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Results Table -->
                    <div class="table-responsive">
                        <table class="table table-hover border">
                            <thead class="table-light">
                                <tr>
                                    <th>Event</th>
                                    <th>Category</th>
                                    <th>Finish Time</th>
                                    <th>Overall Position</th>
                                    <th>Category Position</th>
                                    <th>Pace</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Model.OrderByDescending(r => r.ResultID))
                                {
                                    <tr>
                                        <td>
                                            <strong>@result.EventName</strong>
                                        </td>
                                        <td>
                                            @result.CategoryName
                                        </td>
                                        <td>
                                            @if (result.FinishTime.HasValue)
                                            {
                                                <span class="badge bg-info">@result.FinishTime.Value.ToString(@"hh\:mm\:ss")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (result.OverallPosition.HasValue && result.OverallTotal.HasValue)
                                            {
                                                <div>
                                                    <strong>#@result.OverallPosition</strong>
                                                    <small class="text-muted">/ @result.OverallTotal</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (result.CategoryPosition.HasValue && result.CategoryTotal.HasValue)
                                            {
                                                <div>
                                                    <strong>#@result.CategoryPosition</strong>
                                                    <small class="text-muted">/ @result.CategoryTotal</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (result.Pace.HasValue)
                                            {
                                                <span class="badge bg-secondary">@result.Pace.Value.ToString("0.00") min/km</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="#" class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Download Certificate">
                                                <i class="fas fa-download"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-trophy" style="font-size: 4rem; color: #ccc;"></i>
                        </div>
                        <h3 class="text-muted mb-2">
                            @(isOrganiser ? "No Results Available" : "No Race Results Yet")
                        </h3>
                        <p class="text-muted mb-4">
                            @(isOrganiser 
                                ? "Once participants complete races, their results will appear here."
                                : "Complete a race to see your results here. Enrol in an event to get started!")
                        </p>
                        <a href="@Url.Action("Index", "Events")" class="btn btn-primary">
                            <i class="fas fa-calendar me-2"></i>Browse Events
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Performance Insights Section -->
    @if (Model != null && Model.Any())
    {
        <div class="container mb-5">
            <div class="row">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="fas fa-chart-line me-2" style="color: #667eea;"></i>Your Performance
                            </h5>
                            <ul class="list-unstyled">
                                @{
                                    var topFinishes = Model.Where(r => r.OverallPosition.HasValue).OrderBy(r => r.OverallPosition).Take(3).ToList();
                                    if (topFinishes.Any())
                                    {
                                        <li class="mb-3">
                                            <strong>Top 3 Finishes:</strong>
                                        </li>
                                        @foreach (var result in topFinishes)
                                        {
                                            <li class="mb-2 ms-3">
                                                <i class="fas fa-star text-warning me-2"></i>
                                                @result.EventName - <strong>#@result.OverallPosition</strong> overall
                                            </li>
                                        }
                                    }
                                }
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>@Model.Count</strong> races completed
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="fas fa-question-circle me-2" style="color: #667eea;"></i>Need Help?
                            </h5>
                            <p class="text-muted mb-3">
                                Have questions about your results? Check our FAQ or contact support.
                            </p>
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary">
                                    <i class="fas fa-question me-2"></i>View FAQ
                                </button>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Back to Home
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
