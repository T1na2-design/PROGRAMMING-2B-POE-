@model IEnumerable<RaceDayMVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Events - RaceDay";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="fw-bold">
                <i class="fas fa-flag-checkered me-2" style="color: #667eea;"></i>Race Events
            </h1>
            <p class="text-muted">Browse and join exciting racing events</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); border: none;">
                <i class="fas fa-plus me-2"></i>Create Event
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">@raceEvent.EventName</h5>
                            <p class="card-text text-muted">@raceEvent.Description</p>
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>@raceEvent.EventDate.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                            <a asp-action="Details" asp-route-id="@raceEvent.EventId" class="btn btn-sm btn-outline-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No events available yet.</strong><br />
            <small>Check back soon or create a new event if you're an organizer!</small>
        </div>
    }
</div>
