@model RaceDayMVC.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event - RaceDay";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Page Header -->
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <a href="@Url.Action("Index", "Events")" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-2"></i>Back to Events
                    </a>
                </div>
                <h1 class="display-5 fw-bold mb-2">
                    <i class="fas fa-plus-circle me-3" style="color: #667eea;"></i>Create New Event
                </h1>
                <p class="text-muted lead">Organize and host your racing event</p>
            </div>

            <!-- Form Card -->
            <div class="card shadow-lg border-0 rounded-3">
                <!-- Top Racing Stripe -->
                <div style="height: 4px; background: linear-gradient(90deg, #ff6b6b 0%, #ffd93d 50%, #6bcf7f 100%);"></div>

                <div class="card-body p-5">
                    <!-- Error Messages -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Please fix the following errors:</strong>
                            <div asp-validation-summary="All" class="mt-2"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" action="@Url.Action("Create", "Events")" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Title Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #333;">
                                <i class="fas fa-heading me-2" style="color: #667eea;"></i>Event Information
                            </h5>

                            <!-- Event Title -->
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-600" style="color: #333;">Event Title</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-flag-checkered" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="Title" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="e.g., Cape Town Marathon 2024"
                                           maxlength="200">
                                </div>
                                <small class="text-muted d-block mt-1">5-200 characters</small>
                                <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-600" style="color: #333;">Description</label>
                                <textarea asp-for="Description" 
                                          class="form-control" 
                                          rows="5" 
                                          placeholder="Describe your event, what participants can expect, important details, etc."
                                          maxlength="2000"></textarea>
                                <small class="text-muted d-block mt-1">20-2000 characters</small>
                                <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Banner Image -->
                            <div class="mb-3">
                                <label asp-for="BannerImage" class="form-label fw-600" style="color: #333;">Banner Image (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-image" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="BannerImage" 
                                           type="file" 
                                           class="form-control border-start-0 ps-2"
                                           accept="image/*">
                                </div>
                                <small class="text-muted d-block mt-1">Upload a cover image for your event. Recommended: 16:9 aspect ratio, max 5MB</small>
                                <span asp-validation-for="BannerImage" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <hr>

                        <!-- Date & Time Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #333;">
                                <i class="fas fa-calendar-alt me-2" style="color: #667eea;"></i>Date & Time
                            </h5>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="EventDate" class="form-label fw-600" style="color: #333;">Event Date</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-calendar" style="color: #667eea;"></i>
                                            </span>
                                            <input asp-for="EventDate" 
                                                   type="date" 
                                                   class="form-control border-start-0 ps-2">
                                        </div>
                                        <span asp-validation-for="EventDate" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="EventTime" class="form-label fw-600" style="color: #333;">Start Time</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-clock" style="color: #667eea;"></i>
                                            </span>
                                            <input asp-for="EventTime" 
                                                   type="time" 
                                                   class="form-control border-start-0 ps-2">
                                        </div>
                                        <span asp-validation-for="EventTime" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Location Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #333;">
                                <i class="fas fa-map-marker-alt me-2" style="color: #667eea;"></i>Location
                            </h5>

                            <!-- Venue -->
                            <div class="mb-3">
                                <label asp-for="Venue" class="form-label fw-600" style="color: #333;">Venue</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-building" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="Venue" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="e.g., Table Mountain Stadium"
                                           maxlength="200">
                                </div>
                                <small class="text-muted d-block mt-1">Specific location or starting point</small>
                                <span asp-validation-for="Venue" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- City & Province Row -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="City" class="form-label fw-600" style="color: #333;">City</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-city" style="color: #667eea;"></i>
                                            </span>
                                            <input asp-for="City" 
                                                   type="text" 
                                                   class="form-control border-start-0 ps-2" 
                                                   placeholder="e.g., Cape Town"
                                                   maxlength="100">
                                        </div>
                                        <span asp-validation-for="City" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Province" class="form-label fw-600" style="color: #333;">Province</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-map" style="color: #667eea;"></i>
                                            </span>
                                            <select asp-for="Province" class="form-select border-start-0 ps-2">
                                                <option value="">-- Select Province --</option>
                                                <option value="Eastern Cape">Eastern Cape</option>
                                                <option value="Free State">Free State</option>
                                                <option value="Gauteng">Gauteng</option>
                                                <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                                <option value="Limpopo">Limpopo</option>
                                                <option value="Mpumalanga">Mpumalanga</option>
                                                <option value="Northern Cape">Northern Cape</option>
                                                <option value="North West">North West</option>
                                                <option value="Western Cape">Western Cape</option>
                                            </select>
                                        </div>
                                        <span asp-validation-for="Province" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Race Details Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #333;">
                                <i class="fas fa-shoe-prints me-2" style="color: #667eea;"></i>Race Details
                            </h5>

                            <!-- Event Type -->
                            <div class="mb-3">
                                <label asp-for="EventType" class="form-label fw-600" style="color: #333;">Event Type</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-trophy" style="color: #667eea;"></i>
                                    </span>
                                    <select asp-for="EventType" class="form-select border-start-0 ps-2">
                                        <option value="">-- Select Event Type --</option>
                                        <option value="Running">Running</option>
                                        <option value="Walking">Walking</option>
                                        <option value="Cycling">Cycling</option>
                                        <option value="Triathlon">Triathlon</option>
                                        <option value="Multi-Sport">Multi-Sport</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <span asp-validation-for="EventType" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Distance Row -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Distance" class="form-label fw-600" style="color: #333;">Distance</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-ruler" style="color: #667eea;"></i>
                                            </span>
                                            <input asp-for="Distance" 
                                                   type="number" 
                                                   step="0.1"
                                                   class="form-control border-start-0 ps-2" 
                                                   placeholder="e.g., 42.2"
                                                   min="0.1"
                                                   max="999.9">
                                        </div>
                                        <small class="text-muted d-block mt-1">0.1 - 999.9</small>
                                        <span asp-validation-for="Distance" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DistanceUnit" class="form-label fw-600" style="color: #333;">Distance Unit</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-tape" style="color: #667eea;"></i>
                                            </span>
                                            <select asp-for="DistanceUnit" class="form-select border-start-0 ps-2">
                                                <option value="km">Kilometers (km)</option>
                                                <option value="miles">Miles</option>
                                            </select>
                                        </div>
                                        <span asp-validation-for="DistanceUnit" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Participants Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #333;">
                                <i class="fas fa-users me-2" style="color: #667eea;"></i>Capacity
                            </h5>

                            <div class="mb-3">
                                <label asp-for="MaxParticipants" class="form-label fw-600" style="color: #333;">Maximum Participants</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user-check" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="MaxParticipants" 
                                           type="number" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="e.g., 500"
                                           min="10"
                                           max="100000">
                                </div>
                                <small class="text-muted d-block mt-1">Between 10 and 100,000 participants</small>
                                <span asp-validation-for="MaxParticipants" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <hr>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Index", "Events")" class="btn btn-outline-secondary px-4 py-2">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-600" style="background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); border: none;">
                                <i class="fas fa-check me-2"></i>Create Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Card -->
            <div class="card shadow-sm border-0 rounded-3 mt-5">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">
                        <i class="fas fa-lightbulb me-2" style="color: #ffd93d;"></i>Tips for Creating a Successful Event
                    </h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Compelling Title:</strong> Make it clear and exciting to attract participants
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Detailed Description:</strong> Include course info, difficulty level, and what to expect
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Banner Image:</strong> A professional image increases registration rates
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Accurate Details:</strong> Ensure all dates, times, and locations are correct
                        </li>
                        <li>
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Realistic Capacity:</strong> Set a capacity that matches your venue
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function() {
            // Initialize jQuery validation
            $('form').validate({
                ignore: [],
                errorClass: 'is-invalid',
                validClass: 'is-valid',
                highlight: function(element, errorClass, validClass) {
                    $(element).removeClass(validClass).addClass(errorClass);
                    $(element).closest('.input-group').find('input, select, textarea').addClass(errorClass);
                },
                unhighlight: function(element, errorClass, validClass) {
                    $(element).removeClass(errorClass).addClass(validClass);
                    $(element).closest('.input-group').find('input, select, textarea').removeClass(errorClass).addClass(validClass);
                },
                errorPlacement: function(error, element) {
                    if (element.closest('.input-group').length) {
                        error.insertAfter(element.closest('.input-group'));
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            // Set minimum date to today
            var today = new Date().toISOString().split('T')[0];
            $('#EventDate').attr('min', today);
        });
    </script>
}
