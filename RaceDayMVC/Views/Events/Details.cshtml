@model RaceDayMVC.ViewModels.EventDetailsViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Event Details - RaceDay";

    // Get user role from session
    var userRole = Context.Session.GetString("userRole") ?? string.Empty;
    var isOrganiser = userRole.Equals("Organiser", StringComparison.OrdinalIgnoreCase);
    var isParticipant = userRole.Equals("Participant", StringComparison.OrdinalIgnoreCase);
}

<div class="event-details-page">
    <!-- Hero Header Section -->
    <div class="hero-section" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 0; margin-bottom: 40px;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4 fw-bold mb-3">@Model?.Title</h1>
                    <p class="lead mb-4">@Model?.Description</p>

                    <div class="row text-white gx-4">
                        <div class="col-md-3">
                            <small class="text-white-50">Date</small>
                            <p class="h6 mb-3">
                                <i class="fas fa-calendar me-2"></i>
                                @Model?.EventDate.ToString("dddd, MMMM dd, yyyy")
                            </p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50">Venue</small>
                            <p class="h6 mb-3">
                                <i class="fas fa-map-marker-alt me-2"></i>
                                @Model?.Venue, @Model?.City
                            </p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50">Distance</small>
                            <p class="h6 mb-3">
                                <i class="fas fa-ruler me-2"></i>
                                @Model?.Distance @Model?.DistanceUnit
                            </p>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50">Status</small>
                            <p class="h6 mb-3">
                                <span class="badge bg-success">@Model?.Status</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <div class="card border-0 bg-white bg-opacity-10" style="padding: 30px;">
                        <p class="text-white-50 small mb-2">Event Type</p>
                        <h3 class="text-white fw-bold mb-4">@Model?.EventType</h3>

                        <p class="text-white-50 small mb-2">Province</p>
                        <p class="text-white h6 mb-4">@Model?.Province</p>

                        @if (Model?.MaxParticipants.HasValue ?? false)
                        {
                            <p class="text-white-50 small mb-2">Max Participants</p>
                            <p class="h5 text-warning mb-0">@Model?.MaxParticipants</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="btn-group" role="group">
                        @if (isOrganiser)
                        {
                            <a href="@Url.Action("Edit", "Events", new { id = Model?.EventID })" class="btn btn-light">
                                <i class="fas fa-edit me-2"></i>Edit Event
                            </a>
                            <a href="@Url.Action("Manage", "Events", new { id = Model?.EventID })" class="btn btn-light">
                                <i class="fas fa-cogs me-2"></i>Manage Event
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Events")" class="btn btn-light">
                                <i class="fas fa-arrow-left me-2"></i>Back to Events
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="container mb-5">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold mb-4">
                    <i class="fas fa-list me-2" style="color: #667eea;"></i>Available Categories
                </h2>

                @if (Model?.Categories != null && Model.Categories.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover border">
                            <thead class="table-light">
                                <tr>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <th>Distance</th>
                                    <th>Entry Fee</th>
                                    <th>Start Time</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td>
                                            <strong>@category.CategoryName</strong>
                                        </td>
                                        <td>@category.Description</td>
                                        <td>
                                            <span class="badge bg-info">@category.Distance @category.DistanceUnit</span>
                                        </td>
                                        <td>
                                            <strong>R @category.EntryFee.ToString("0.00")</strong>
                                        </td>
                                        <td>
                                            @category.StartTime.ToString("HH:mm")
                                        </td>
                                        <td class="text-center">
                                            @if (isParticipant)
                                            {
                                                <button class="btn btn-sm btn-primary" 
                                                        onclick="enrollCategory(@category.CategoryID, '@category.CategoryName')">
                                                    <i class="fas fa-check me-1"></i>Enrol
                                                </button>
                                            }
                                            @if (isOrganiser)
                                            {
                                                <a href="@Url.Action("EditCategory", "Events", new { id = Model?.EventID, categoryId = category.CategoryID })" 
                                                   class="btn btn-sm btn-warning">
                                                    <i class="fas fa-edit me-1"></i>Edit
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        No categories available for this event yet.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Additional Event Info -->
    <div class="container mb-5">
        <div class="row">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">
                            <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Event Information
                        </h5>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <strong>Event Type:</strong> @Model?.EventType
                            </li>
                            <li class="mb-2">
                                <strong>Distance:</strong> @Model?.Distance @Model?.DistanceUnit
                            </li>
                            <li class="mb-2">
                                <strong>Location:</strong> @Model?.Venue, @Model?.City, @Model?.Province
                            </li>
                            <li>
                                <strong>Max Participants:</strong> @(Model?.MaxParticipants?.ToString() ?? "Unlimited")
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">
                            <i class="fas fa-question-circle me-2" style="color: #667eea;"></i>Need Help?
                        </h5>
                        <p class="text-muted mb-3">
                            Have questions about this event? Contact the event organizer or check our FAQ.
                        </p>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-envelope me-2"></i>Contact Organizer
                            </button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function enrollCategory(categoryId, categoryName) {
            // Check if user is authenticated
            const userEmail = '@Context.Session.GetString("userEmail")';
            if (!userEmail) {
                alert('Please log in to enrol in a category.');
                window.location.href = '@Url.Action("Login", "Account")';
                return;
            }

            // Confirm enrollment
            if (confirm(`Are you sure you want to enrol in ${categoryName}?`)) {
                console.log(`Enrolling in category ${categoryId}`);
                // TODO: Implement enrollment API call
                alert('Enrollment feature coming soon!');
            }
        }
    </script>
}
