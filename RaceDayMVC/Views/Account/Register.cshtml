@model RaceDayMVC.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register - RaceDay";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px 0;">
    <div class="col-md-6">
        <!-- Card Header -->
        <div class="card shadow-lg border-0 rounded-3">
            <!-- Top Racing Stripe -->
            <div style="height: 4px; background: linear-gradient(90deg, #ff6b6b 0%, #ffd93d 50%, #6bcf7f 100%);"></div>

            <div class="card-body p-5">
                <!-- Logo/Title Section -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2" style="color: #333;">
                        <i class="fas fa-flag-checkered me-2" style="color: #667eea;"></i>RaceDay
                    </h2>
                    <p class="text-muted mb-0">Create your racing account</p>
                </div>

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Registration Form -->
                <form method="post" action="/Account/Register" novalidate>
                    <!-- Name Row -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label fw-600" style="color: #333;">First Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="FirstName" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="John"
                                           required>
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label fw-600" style="color: #333;">Last Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user" style="color: #667eea;"></i>
                                    </span>
                                    <input asp-for="LastName" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="Doe"
                                           required>
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-600" style="color: #333;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="john@example.com"
                                   required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="mb-3">
                        <label for="dateOfBirth" class="form-label fw-600" style="color: #333;">Date of Birth</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-birthday-cake" style="color: #667eea;"></i>
                            </span>
                            <input type="date" 
                                   id="dateOfBirth"
                                   name="dateOfBirth" 
                                   class="form-control border-start-0 ps-2" 
                                   required>
                        </div>
                        <small class="text-muted d-block mt-1">Required to verify age eligibility</small>
                    </div>

                    <!-- Role Selection -->
                    <div class="mb-3">
                        <label for="role" class="form-label fw-600" style="color: #333;">Role</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-users" style="color: #667eea;"></i>
                            </span>
                            <select id="role" 
                                    name="role" 
                                    class="form-select border-start-0 ps-2" 
                                    required>
                                <option value="">-- Select your role --</option>
                                <option value="Participant">
                                    <i class="fas fa-person-running"></i> Participant
                                </option>
                                <option value="Organiser">
                                    <i class="fas fa-clipboard-list"></i> Organiser
                                </option>
                            </select>
                        </div>
                        <small class="text-muted d-block mt-1">
                            <strong>Participant:</strong> Race in events • 
                            <strong>Organiser:</strong> Create and manage races
                        </small>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-600" style="color: #333;">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Minimum 8 characters"
                                   required>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        <small class="text-muted d-block mt-1">At least 8 characters with uppercase, lowercase, and numbers</small>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-600" style="color: #333;">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-check-circle" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="ConfirmPassword" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Re-enter your password"
                                   required>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Terms Checkbox -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="terms" required style="border-color: #667eea;">
                        <label class="form-check-label" for="terms" style="color: #666;">
                            I agree to the <a href="#" style="color: #667eea; text-decoration: none;">Terms of Service</a> and 
                            <a href="#" style="color: #667eea; text-decoration: none;">Privacy Policy</a>
                        </label>
                        <span class="text-danger small d-block mt-1" id="termsError" style="display: none;">
                            You must agree to the terms to continue
                        </span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-600 mb-3" style="background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); border: none;">
                        <i class="fas fa-user-plus me-2"></i>Create Account
                    </button>
                </form>

                <!-- Divider -->
                <hr class="my-4">

                <!-- Login Link -->
                <div class="text-center">
                    <p class="text-muted mb-0">
                        Already have an account?
                        <a href="@Url.Action("Login", "Account")" class="fw-600" style="color: #667eea; text-decoration: none;">
                            Sign in here
                            <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </p>
                </div>

                <!-- Footer Info -->
                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-0">
                        <i class="fas fa-shield-alt me-1"></i>Your data is secure and encrypted
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4">
            <p class="text-white-50">
                © 2026 RaceDay. All rights reserved.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Enhanced form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const termsCheckbox = document.getElementById('terms');
            if (!termsCheckbox.checked) {
                e.preventDefault();
                document.getElementById('termsError').style.display = 'block';
                termsCheckbox.classList.add('is-invalid');
            }
        });
    </script>
}
