@model RaceDayMVC.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register - RaceDay";
}

<div style="background-color: #f3f4f6; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 30px 0;">
    <div style="width: 100%; max-width: 600px;">
        <!-- Card -->
        <div class="card shadow-lg border-0 rounded-3">
            <!-- Top Racing Stripe -->
            <div style="height: 4px; background: linear-gradient(90deg, #ff6b6b 0%, #ffd93d 50%, #6bcf7f 100%);"></div>

            <div class="card-body p-5">
                <!-- Logo/Title Section -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2" style="color: #111827;">
                        <i class="fas fa-person-running me-2" style="color: #f97316;"></i>RaceDay
                    </h2>
                    <p style="color: #6b7280; margin-bottom: 0;">Create your racing account</p>
                </div>

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-left: 4px solid #dc3545;">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-exclamation-triangle me-3 mt-1" style="font-size: 1.2em;"></i>
                            <div class="flex-grow-1">
                                <strong style="font-size: 1.05em;">Registration Error</strong>
                                <div asp-validation-summary="All" class="mt-2">
                                    <style>
                                        .validation-summary-errors {
                                            list-style: none;
                                            padding: 0;
                                            margin: 0;
                                        }
                                        .validation-summary-errors li {
                                            padding: 6px 0;
                                            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                                        }
                                        .validation-summary-errors li:last-child {
                                            border-bottom: none;
                                        }
                                    </style>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }

                <!-- Registration Form -->
                <form method="post" action="@Url.Action("Register", "Account")" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Name Row -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label fw-600" style="color: #111827;">First Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user" style="color: #f97316;"></i>
                                    </span>
                                    <input asp-for="FirstName" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="John"
                                           autocomplete="given-name">
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label fw-600" style="color: #111827;">Last Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user" style="color: #f97316;"></i>
                                    </span>
                                    <input asp-for="LastName" 
                                           type="text" 
                                           class="form-control border-start-0 ps-2" 
                                           placeholder="Doe"
                                           autocomplete="family-name">
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-600" style="color: #111827;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="john@example.com"
                                   autocomplete="email">
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-600" style="color: #111827;">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-phone" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="PhoneNumber" 
                                   type="tel" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="+27 (21) 555-0000"
                                   autocomplete="tel">
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- ID Number -->
                    <div class="mb-3">
                        <label asp-for="IDNumber" class="form-label fw-600" style="color: #111827;">ID Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-id-card" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="IDNumber" 
                                   type="text" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="13-digit SA ID number"
                                   autocomplete="off">
                        </div>
                        <span asp-validation-for="IDNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Emergency Contact Name -->
                    <div class="mb-3">
                        <label asp-for="EmergencyContactName" class="form-label fw-600" style="color: #111827;">Emergency Contact Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-user-plus" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="EmergencyContactName" 
                                   type="text" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Full name"
                                   autocomplete="name">
                        </div>
                        <span asp-validation-for="EmergencyContactName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Emergency Contact Number -->
                    <div class="mb-3">
                        <label asp-for="EmergencyContactNumber" class="form-label fw-600" style="color: #111827;">Emergency Contact Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-phone-alt" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="EmergencyContactNumber" 
                                   type="tel" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="+27 (21) 555-0000"
                                   autocomplete="tel">
                        </div>
                        <span asp-validation-for="EmergencyContactNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Medical Conditions (Optional) -->
                    <div class="mb-3">
                        <label asp-for="MedicalConditions" class="form-label fw-600" style="color: #111827;">Medical Conditions <span style="color: #999;">(Optional)</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-heartbeat" style="color: #f97316;"></i>
                            </span>
                            <textarea asp-for="MedicalConditions" 
                                      class="form-control border-start-0 ps-2" 
                                      placeholder="Enter any relevant medical conditions or allergies"
                                      rows="2"></textarea>
                        </div>
                        <span asp-validation-for="MedicalConditions" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Club Affiliation (Optional) -->
                    <div class="mb-3">
                        <label asp-for="ClubAffiliation" class="form-label fw-600" style="color: #111827;">Club Affiliation <span style="color: #999;">(Optional)</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-users" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="ClubAffiliation" 
                                   type="text" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Running club or organization"
                                   autocomplete="organization">
                        </div>
                        <span asp-validation-for="ClubAffiliation" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Gender -->
                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label fw-600" style="color: #111827;">Gender</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-venus-mars" style="color: #f97316;"></i>
                            </span>
                            <select asp-for="Gender" class="form-select border-start-0 ps-2">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="mb-3">
                        <label asp-for="DateOfBirth" class="form-label fw-600" style="color: #111827;">Date of Birth</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-calendar" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="DateOfBirth" 
                                   type="date" 
                                   class="form-control border-start-0 ps-2"
                                   autocomplete="bday">
                        </div>
                        <small style="color: #6b7280; display: block; margin-top: 0.25rem;">
                            <i class="fas fa-info-circle"></i> Required to verify age eligibility
                        </small>
                        <span asp-validation-for="DateOfBirth" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Role Selection -->
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-600" style="color: #111827;">Role</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-users" style="color: #f97316;"></i>
                            </span>
                            <select asp-for="Role" class="form-select border-start-0 ps-2">
                                <option value="">-- Select your role --</option>
                                <option value="Participant">
                                    <i class="fas fa-person-running"></i> Participant
                                </option>
                                <option value="Organiser">
                                    <i class="fas fa-clipboard-list"></i> Organiser
                                </option>
                            </select>
                        </div>
                        <small style="color: #6b7280; display: block; margin-top: 0.25rem;">
                            <strong>Participant:</strong> Register and participate in races • 
                            <strong>Organiser:</strong> Create and manage racing events
                        </small>
                        <span asp-validation-for="Role" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-600" style="color: #111827;">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Minimum 8 characters"
                                   autocomplete="new-password">
                        </div>
                        <small style="color: #6b7280; display: block; margin-top: 0.25rem;">
                            <i class="fas fa-shield-alt"></i> At least 8 characters with uppercase, lowercase, and numbers
                        </small>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-600" style="color: #111827;">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-check-circle" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="ConfirmPassword" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Re-enter your password"
                                   autocomplete="new-password">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Terms Checkbox -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="terms" name="AgreeToTerms" required style="border-color: #f97316; accent-color: #f97316;">
                        <label class="form-check-label" for="terms" style="color: #666;">
                            I agree to the <a href="#" style="color: #f97316; text-decoration: none;">Terms of Service</a> and 
                            <a href="#" style="color: #f97316; text-decoration: none;">Privacy Policy</a>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn w-100 py-2 fw-600 mb-3" style="background-color: #f97316; color: white; border: none; transition: all 0.3s ease;">
                        <i class="fas fa-user-plus me-2"></i>Create Account
                    </button>
                </form>

                <!-- Divider -->
                <hr class="my-4">

                <!-- Login Link -->
                <div class="text-center">
                    <p style="color: #6b7280; margin-bottom: 0;">
                        Already have an account?
                        <a href="@Url.Action("Login", "Account")" class="fw-600" style="color: #f97316; text-decoration: none;">
                            Sign in here
                            <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </p>
                </div>

                <!-- Footer Info -->
                <div class="mt-4 pt-3" style="border-top: 1px solid #e5e7eb; text-align: center;">
                    <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 0;">
                        <i class="fas fa-shield-alt me-1"></i>Your data is secure and encrypted
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
