@model RaceDayMVC.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - RaceDay";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="col-md-5">
        <!-- Card Header -->
        <div class="card shadow-lg border-0 rounded-3">
            <!-- Top Racing Stripe -->
            <div style="height: 4px; background: linear-gradient(90deg, #ff6b6b 0%, #ffd93d 50%, #6bcf7f 100%);"></div>

            <div class="card-body p-5">
                <!-- Logo/Title Section -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2" style="color: #333;">
                        <i class="fas fa-flag-checkered me-2" style="color: #667eea;"></i>RaceDay
                    </h2>
                    <p class="text-muted mb-0">Sign in to your account</p>
                </div>

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Login Form -->
                <form method="post" action="/Account/Login" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-600" style="color: #333;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Enter your email"
                                   required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-600" style="color: #333;">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock" style="color: #667eea;"></i>
                            </span>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Enter your password"
                                   required>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-600 mb-3" style="background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); border: none;">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </button>
                </form>

                <!-- Divider -->
                <hr class="my-4">

                <!-- Register Link -->
                <div class="text-center">
                    <p class="text-muted mb-0">
                        Don't have an account?
                        <a href="@Url.Action("Register", "Account")" class="fw-600" style="color: #667eea; text-decoration: none;">
                            Register here
                            <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </p>
                </div>

                <!-- Footer Info -->
                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-0">
                        <i class="fas fa-shield-alt me-1"></i>Your data is secure and encrypted
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4">
            <p class="text-white-50">
                © 2026 RaceDay. All rights reserved.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
