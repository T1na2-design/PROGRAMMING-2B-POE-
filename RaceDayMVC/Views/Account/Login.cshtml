@model RaceDayMVC.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - RaceDay";
}

<div style="background-color: #f3f4f6; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 30px 0;">
    <div style="width: 100%; max-width: 450px;">
        <!-- Card -->
        <div class="card shadow-lg border-0 rounded-3">
            <!-- Top Racing Stripe -->
            <div style="height: 4px; background: linear-gradient(90deg, #ff6b6b 0%, #ffd93d 50%, #6bcf7f 100%);"></div>

            <div class="card-body p-5">
                <!-- Logo/Title Section -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2" style="color: #111827;">
                        <i class="fas fa-person-running me-2" style="color: #f97316;"></i>RaceDay
                    </h2>
                    <p style="color: #6b7280; margin-bottom: 0;">Sign in to your account</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Login Form -->
                <form method="post" action="/Account/Login" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-600" style="color: #111827;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Enter your email"
                                   required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-600" style="color: #111827;">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock" style="color: #f97316;"></i>
                            </span>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control border-start-0 ps-2" 
                                   placeholder="Enter your password"
                                   required>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn w-100 py-2 fw-600 mb-3" style="background-color: #f97316; color: white; border: none; transition: all 0.3s ease;">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </button>
                </form>

                <!-- Divider -->
                <hr class="my-4">

                <!-- Register Link -->
                <div class="text-center">
                    <p style="color: #6b7280; margin-bottom: 0;">
                        Don't have an account?
                        <a href="@Url.Action("Register", "Account")" class="fw-600" style="color: #f97316; text-decoration: none;">
                            Register here
                            <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </p>
                </div>

                <!-- Footer Info -->
                <div class="mt-4 pt-3" style="border-top: 1px solid #e5e7eb; text-align: center;">
                    <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 0;">
                        <i class="fas fa-shield-alt me-1"></i>Your data is secure and encrypted
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
